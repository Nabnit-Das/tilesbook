# Copy local endpoints and the public key from the Supabase CLI, or run npm run setup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. For operator scripts only. The app performs normal user operations with RLS.
SUPABASE_SERVICE_ROLE_KEY=
# CLI deployment configuration. Set hosted credentials in GitHub Secrets.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
# Fully qualified origin for this installation
APP_URL=http://localhost:3000
# Optional server-side integrations. Provider delivery is disabled by default.
# Enter live provider credentials in the git-ignored .env.providers.local only.
# RESEND_API_KEY, RESEND_FROM_EMAIL, AUTHORIZED_TEST_EMAIL
WHATSAPP_PROVIDER_KEY=
# Optional server-side address for the same Supabase project, on a trusted internal network.
SUPABASE_INTERNAL_URL=
# Embedded local demo with fixed OTP and loopback access only. npm run demo sets this.
TILEBOOK_LOCAL_DEMO=0
# Optional system Chromium executable for PDF generation and Playwright.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Optional private remote Chromium WebSocket for hosted PDF rendering.
PLAYWRIGHT_CDP_ENDPOINT=
